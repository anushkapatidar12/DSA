public class Main{
    public static int Subarray(int[] arr){
        int n = arr.length;
        int curr = arr[0];
        int maax = arr[0]; //global max i.e result
        for(int i = 1; i< n; i++){
            curr = Math.max(arr[i], curr+arr[i]);
            maax = Math.max(curr, maax);
        }
        return maax;
    }
        
        //now we need to find the min array
        public static int Minarray(int[] arr){
            int n = arr.length;
            int curr = arr[0];
            int miin = arr[0];
            for(int i = 0; i< n; i++){
                curr = Math.min(arr[i], curr+arr[i]);
                miin = Math.min(miin, curr);
            }
            return miin;
        }
        
        //circular subarray 
        public static int circular(int[] arr){
            int total = 0;
            for(int i = 0; i<arr.length; i++){
                 total += arr[i];
            }
            int maxNormal = Subarray(arr);
            int minSubarray =Minarray(arr);
            
            int circularSub = total - minSubarray;
            
            if(circularSub < 0){
                return maxNormal;
            }
            return Math.max(circularSub, maxNormal);
        
    }
    public static void main(String[] args){
        int[] arr = {8,-1, 3, -5, 4};
        System.out.println(circular(arr));
        
    }

}
